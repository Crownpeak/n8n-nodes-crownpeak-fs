{
	"name": "n8n-nodes-crownpeak-fs",
	"version": "1.0.0",
	"description": "n8n integration for Crownpeak FS REST API",
	"keywords": [
		"n8n",
		"n8n-nodes",
		"crownpeak",
		"fs",
		"n8n-community-node-package"
	],
	"license": "MIT",
	"author": "Crownpeak Technology, Inc.",
	"repository": {
		"type": "git",
		"url": "https://github.com/Crownpeak/n8n-nodes-crownpeak-fs.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc && npm run copy-assets",
		"test": "jest",
		"format": "prettier --write .",
		"lint": "eslint . --ext .ts",
		"copy-assets": "cp nodes/CrownpeakFS/crownpeak.svg dist/nodes/CrownpeakFS/",
		"prepare": "npm run build"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/nodes/CrownpeakFS/credentials/CrownpeakFSApi.credentials"
		],
		"nodes": [
			"dist/nodes/CrownpeakFS/CrownpeakFS.node.js"
		]
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@typescript-eslint/parser": "~8.32.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"jest": "^30.1.3",
		"prettier": "^3.5.3",
		"ts-jest": "^29.4.3",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
